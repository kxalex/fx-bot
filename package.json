{
	"name": "fx-bot",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest --typecheck --coverage",
		"cf-typegen": "wrangler types",
		"set-webhook": "curl --fail --show-error --silent --request POST \"https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook\" --form \"url=$TELEGRAM_WEBHOOK_URL\"",
		"prettier": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" vitest.config.ts"
	},
	"dependencies": {
		"grammy": "^1.46.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "~0.22.0",
		"@types/node": "26.4.0",
		"@vitest/coverage-istanbul": "4.1.11",
		"@vitest/ui": "4.1.11",
		"prettier": "3.9.6",
		"typescript": "~7.0.2",
		"vitest": "4.1.11",
		"wrangler": "^4.127.1"
	},
	"packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
